isted","exhibited"],0,0],["5734e700139b2109730015cc","Interior (Rome)","Cy Twombly","EC0iU0Hgzp7h4aeVyLoFgA","#362019",10,2016,2016,["listed","exhibited"],0,0],["5734e6fd275b241a9d00149b","Summer Madness (Gaeta/Bassano)","Cy Twombly","5XVN5AJc7wZucmuIJtyjkg","#aba9ac",10,2016,2016,["listed","exhibited"],0,0],["5734e702275b241a9d0014a4","Lepanto VII","Cy Twombly","UX-C5Ors5TfSnxOVyvuuSw","#becad7",10,2016,2016,["listed","exhibited"],0,0],["69735ae64acdb10013a59b6d","Alien Exam (Perceptual Cell Series)","James Turrell","9rqK97eudtPIkO2FOgsvNQ","#2c2020",11,2017,2017,["exhibited"],"unna-de","zurich-ch"],["5bbf2eda44110a3e5306a452","Femme nue debout, de dos","Auguste Rodin","v0xGacp0EoWNFD8tTL7NXg","#e0d8c7",12,2018,2018,["listed"],0,"new-york-us"],["5fad2f1f803a540010fefeb4","Architekturcollage","Isa Genzken","5mydoiWyZ2pELGBo55LS9Q","#929395",13,2020,2025,["listed","exhibited"],0,0],["6627de2af1538f000e865757","Untitled","Roni Horn","ctMaHYoRlCIFBWvrXXSu9Q","#f1dcb5",13,2024,2024,["listed"],0,0],["608d502e844940000f5e5745","Unfinished Painting (Gaeta)","Cy Twombly","OyiKsebVju0AcUAc1gwYOQ","#e7e3d9",14,2021,2021,["listed"],0,0],["6220d93fc8df9d000cd03e9c","Hand trained, Let the crossing be indicated to the state. He lost his jacket again and again, until there was no need for jackets a cool morning, the long train, I wanted it around the whole width of my body and got nothing, then something, then a big light, warm biceps and strangely a glide along the floor.","Rindon Johnson","cVBJ5XL46-_gexojxZcSCQ","#c6cacc",15,2022,2022,["exhibited","listed"],0,0],["650448efeb308d000b5353cd","Open: I want it to say, procession. Turn around and have a look at the river. Crocodiles have red eyes at night. Have a look at the river, now pretend you’re me. Now ask yourself.","Rindon Johnson","v4Ic0IJdKoV251ELCdxtAw","#a5a5a5",15,2023,2023,["listed"],"berlin-de",0],["65d3648009beb6000bde603d","Lyn Says #2: One sits in a cloven space. Patterns promote an outward likeness, between little white silences. The big trees catch all the moisture from what seems like a dry night. Reflections don't make shade, but shadows are, and do. In order to understand the nature of the collision, one must know something of the nature of the motions involved--that is, a history. He looked at me and smiled and did not look away, and thus a friendship became erotic. Luck was rid of its clover.","Rindon Johnson","I_SxORdCDGY-cF2eJsQA9A","#bbb7b1",15,2024,2024,["listed"],0,0],["63ff134c38d237000d59fe36","S #22","Beate Gütschow","lJbMI7-ipjortyNtnl99sg","",16,2023,2023,["listed"],0,0],["653a51de547dcd000ad3344d","Colombe volant - Arc en ciel","Pablo Picasso","He6VYkxeWS_RXoRL-RVjeA","#dbdccb",17,2023,2023,["listed"],0,0],["659f82c9f78cad000b911609","Quatre Femmes nues et Tete sculptée","Pablo Picasso","1Q8VBK6G_oJNYIcyhM6zvw","#3d3936",17,2024,2024,["listed"],0,"rheinstetten-de"],["6a4cd8d38f2011000e360d9a","L'Equinoxe","Georges Braque","W00S6gjfj8TE1yYkTSOmSg","#bbbcb4",17,2026,2026,["listed"],0,0],["6500426d8192b6000aee8156","Lake View","Isca Greenfield-Sanders","ev1u79HYblTd3KLmKAosjQ","#d1cfd0",18,2023,2023,["exhibited","listed"],0,0],["69c6505fbfe13e6916a59332","M, B 290324","Peter Krauskopf","DlgZw2teFAT1QzvBFKfgrw","#dfdee0",19,2024,2026,["exhibited","listed"],0,0],["52138fc38b3b81b53a00013d","Self-portrait","Albrecht Dürer","9NQX277XBdvBvKFJ8BoXGQ","#443423",20,0,0,["held"],0,"nuremberg-de"],["5ba7c2b48126a028d02a40fb","Ohne Titel","Georg Baselitz","hQw0MG-0--1XdK7a_eoy_A","#30383e",21,0,0,["owned"],0,0],["5d7911a39960ca000e67bcdf","Untitled (Detail of Painting)","Cy Twombly","q2fjwUqdCWMjaOx-Nskt2w","#f0eee9",22,0,0,["made"],0,0],["6515b06c558325000b24182c","Untitled (Detail of Painting), from Re-Object Mythos","Cy Twombly","25EYDx3t_eg03cZw3l22cA","#d5ccdb",22,0,0,["made"],0,0],["6541234daae16e000dae5f00","Untitled (Detail of Painting), from Re-Object Mythos","Cy Twombly","mB1-NN287BzJzummbp3CBg","#d5ccdb",22,0,0,["made"],0,0],["553eb6f264626c7c79990000","La Tour