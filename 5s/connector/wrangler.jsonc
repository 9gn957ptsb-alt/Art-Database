/**
 * 5s as a Claude connector (README.md "The one-time setup").
 * Secrets are never written here: set them with `npx wrangler secret put <NAME>`:
 *   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, COOKIE_ENCRYPTION_KEY
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fives-connector",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: the agents package needs it. global_fetch_strictly_public: required by the OAuth
  // provider for Client ID Metadata Documents (its SSRF protection); every fetch 5s makes is public.
  // It also keeps read_link, bring_in and item_image (src/web.js) on the public internet, under the
  // connector's own address, DNS and redirect checks.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Two Durable Object classes, both SQLite-backed (the only kind on Workers Free): FiveSMCP, one per
  // MCP session (the agents package's McpAgent), and FiveSPerson, one per person, holding their 5s
  // (src/person.js). v2 adds FiveSPerson beside v1; nothing is removed.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FiveSMCP"] },
    { "tag": "v2", "new_sqlite_classes": ["FiveSPerson"] }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "FiveSMCP" },
      { "name": "PERSON", "class_name": "FiveSPerson" }
    ]
  },
  // One KV namespace, the OAuth provider's: sign-ins and tokens only (a few writes per sign-in, see
  // costs.js TOKEN_LIFETIMES). Create it first (README step 4) and paste its id in here. Each person's
  // 5s is in FiveSPerson, never in KV.
  "kv_namespaces": [
    { "binding": "OAUTH_KV" }
  ],
  // Workers Rate Limiting (index.ts): /mcp per signed-in person, and the sign-in endpoints anyone can
  // reach (/register, /authorize, /token, /callback) per address. namespace_id is any number unique
  // in the Cloudflare account. Without these two bindings the Worker still runs, unlimited.
  // RATE_LIMIT_WEB: calls that read other sites (read_link, bring_in, item_image) per person.
  "ratelimits": [
    { "name": "RATE_LIMIT_PERSON", "namespace_id": "5001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RATE_LIMIT_SIGNIN", "namespace_id": "5002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RATE_LIMIT_WEB", "namespace_id": "5003", "simple": { "limit": 30, "period": 60 } }
  ],
  // COLOUR_BUDGET_PX: pixels one bring_in (or item_image) call may decode to read a picture's colours,
  // surface and texture in the connector. Decoding takes about 0.2 s of CPU a megapixel, and Workers
  // Free allows 10 ms of CPU a request, so on Free it is "0": every brought picture's colours are then
  // read by the 5s app when it next opens. On Workers Paid delete this line (the default is 4000000).
  "vars": { "COLOUR_BUDGET_PX": "0" },
  "observability": { "enabled": true },
  "dev": { "port": 8800, "inspector_port": 8801 }
}
